# FinSight 酒研助手 · 环境变量模板
#
# 用法：复制本文件为 .env，按本机实际情况填写。
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
#
# 优先级：系统环境变量 > .env > config.ini
# （.env 不会覆盖已经存在的系统环境变量）

# ---------- LLM（DeepSeek） ----------
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---------- MySQL（财务指标 / 会话历史） ----------
MYSQL_PASSWORD=你的mysql密码

# ---------- Redis（语义缓存；留空表示不需要密码） ----------
REDIS_PASSWORD=

# ---------- Neo4j（股东图谱，可选，不装就保持 [graph] enabled=false） ----------
NEO4J_PASSWORD=

# ---------- 可选：模型权重目录 ----------
# 默认 C:\pro\models；找不到会自动回退到旧项目 rag_qa/models
# FIN_MODEL_ROOT=C:\pro\models
