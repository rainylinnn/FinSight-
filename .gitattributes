# 统一换行策略：仓库内存 LF，Windows 脚本检出为 CRLF
* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.py text eol=lf
*.js text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ini text eol=lf
*.csv text eol=lf
*.html text eol=lf
*.css text eol=lf

# 二进制资源不做换行转换
*.woff2 binary
*.woff binary
*.ttf binary
*.png binary
*.jpg binary
*.pdf binary
*.pptx binary
*.docx binary
